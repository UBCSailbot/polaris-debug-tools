{
  "name": "sailbot-devboard-gui",
  "version": "1.0.0",
  "description": "UBC Sailbot dev board protocol tester GUI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "build": "electron-builder"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.sailbot.devboard",
    "productName": "Sailbot Dev Board",
    "files": [
      "frontend/**",
      "main.js",
      "preload.js"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
